{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astroai.github.io/torchsky-harness/schemas/release-performance-claims-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "task", "evaluation", "row_selector", "timing_field", "correctness_source", "baseline_artifact", "candidate_artifact", "task_artifact", "task_command_sha256", "effective_arguments", "dtype", "device", "paired_sampling_policy", "max_regression_fraction", "absolute_timing_floor_ms"],
      "properties": {
        "row_id": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "evaluation": {"type": "string", "minLength": 1},
        "row_selector": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "timing_field": {"type": "string", "minLength": 1},
        "correctness_source": {"type": "object", "minProperties": 2},
        "baseline_artifact": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "candidate_artifact": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "task_artifact": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "task_command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "effective_arguments": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "dtype": {"enum": ["float32", "float64"]},
        "device": {"const": "cpu"},
        "paired_sampling_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "minimum_pairs", "order", "statistic", "pairing_keys"],
          "properties": {
            "mode": {"const": "same_runner_alternating"},
            "minimum_pairs": {"type": "integer", "minimum": 5},
            "order": {"const": "seeded_alternating"},
            "statistic": {"const": "median_paired_ratio"},
            "pairing_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "max_regression_fraction": {"const": 0.05},
        "absolute_timing_floor_ms": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
