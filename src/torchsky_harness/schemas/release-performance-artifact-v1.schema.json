{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astroai.github.io/torchsky-harness/schemas/release-performance-artifact-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "evaluation", "correctness_source", "fingerprint", "source_reports", "rows"],
  "properties": {
    "schema_version": {"const": 1},
    "task": {"type": "string", "minLength": 1},
    "evaluation": {"type": "string", "minLength": 1},
    "correctness_source": {"type": "object", "minProperties": 2},
    "fingerprint": {
      "type": "object",
      "required": ["runner", "cpu", "os", "python", "torch", "torchsky_version", "torchsky_revision", "dtype", "device", "task_command_sha256", "task_arguments"],
      "properties": {
        "runner": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "torch": {"type": "string", "minLength": 1},
        "torchsky_version": {"type": "string", "minLength": 1},
        "torchsky_revision": {"type": "string", "minLength": 1},
        "dtype": {"enum": ["float32", "float64"]},
        "device": {"const": "cpu"},
        "task_command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "task_arguments": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "source_reports": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pair_id", "path", "sha256", "status", "correctness_status", "task", "task_artifact", "envelope_path", "envelope_sha256"],
        "properties": {
          "pair_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"const": "OK"},
          "correctness_status": {"const": "OK"},
          "task": {"type": "string", "minLength": 1},
          "task_artifact": {"type": "string", "minLength": 1},
          "envelope_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    }
  }
}
