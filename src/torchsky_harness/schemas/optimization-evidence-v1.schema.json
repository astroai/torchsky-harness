{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astroai.github.io/torchsky-harness/schemas/optimization-evidence-v1.schema.json",
  "title": "Torchsky optimization evidence",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "evaluation",
    "workstream",
    "profile",
    "device",
    "runtime",
    "subject",
    "harness",
    "rows",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "torchsky-harness.optimization-evidence.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evaluation": {
      "type": "string",
      "minLength": 1
    },
    "workstream": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object"
    },
    "subject": {
      "type": "object",
      "required": ["version", "import_path", "package_content_sha256"]
    },
    "harness": {
      "type": "object",
      "required": ["version", "source"]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
