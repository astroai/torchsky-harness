{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:torchsky-harness:bounded-campaign-matrix:v1",
  "title": "Torchsky bounded comparator campaign matrix",
  "type": "object",
  "required": ["schema_version", "id", "campaign_id", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "certification", "required_peers", "required_metrics", "parameters"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "certification": {"enum": ["internal", "peer"]},
          "required_peers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "required_metrics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "parameters": {"type": "object"},
          "gates": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "min": {"type": "number"},
                "max": {"type": "number"},
                "equals": {"type": ["number", "integer", "boolean", "string"]}
              },
              "minProperties": 1,
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
